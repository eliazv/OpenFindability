# Google Search Console
# Put private service account JSON files under ./secrets/google/.
# Example:
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google/my-project-search-console.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google/example-search-console-service-account.json

# Umami
UMAMI_BASE_URL=https://cloud.umami.is
UMAMI_API_KEY=
