# Google Search Console + Play Console
# Both use the same service account JSON.
# For Play Console: grant the service account "View app information" in Play Console → Users & permissions.
# Put private service account JSON files under ./secrets/google/.
# Example:
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google/my-project-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google/example-service-account.json

# Umami
UMAMI_BASE_URL=https://api.umami.is/v1
UMAMI_API_KEY=

# RespectASO local instance
RESPECT_ASO_BASE_URL=http://localhost

# RevenueCat
# V2 secret key (sk_...) created in the RevenueCat dashboard with the
# "charts_metrics:overview:read" permission enabled.
REVENUECAT_API_KEY=

# AdMob
# OAuth2 client from Google Cloud Console (Desktop app type).
# Run `pnpm run admob:auth` on your own machine (interactive browser login)
# to mint ADMOB_REFRESH_TOKEN.
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=
ADMOB_REFRESH_TOKEN=
# AdMob publisher id, e.g. pub-1234567890123456
ADMOB_PUBLISHER_ID=
