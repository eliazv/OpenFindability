# Google Search Console + Play Console
# Both use the same service account JSON.
# For Play Console: grant the service account "View app information" in Play Console → Users & permissions.
# Put private service account JSON files under ./secrets/google/.
# Example:
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google/my-project-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google/example-service-account.json

# Umami
UMAMI_BASE_URL=https://api.umami.is/v1
UMAMI_API_KEY=

# RespectASO local instance
RESPECT_ASO_BASE_URL=http://localhost

# RevenueCat
# V2 secret key (sk_...) created in the RevenueCat dashboard with the
# "charts_metrics:overview:read" permission enabled.
REVENUECAT_API_KEY=

# AdMob
# OAuth2 client from Google Cloud Console (Desktop app type).
# Run `pnpm run admob:auth` on your own machine (interactive browser login)
# to mint ADMOB_REFRESH_TOKEN.
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=
ADMOB_REFRESH_TOKEN=
# AdMob publisher id, e.g. pub-1234567890123456
ADMOB_PUBLISHER_ID=

# AdSense
ADSENSE_CLIENT_ID=
ADSENSE_CLIENT_SECRET=
ADSENSE_REFRESH_TOKEN=
ADSENSE_ACCOUNT_ID=

# App Store Connect API
# Create a key in App Store Connect → Users and Access → Integrations → App Store Connect API
# (Team Key, "App Manager" role or higher). Put the downloaded .p8 under ./secrets/appstoreconnect/.
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY_PATH=./secrets/appstoreconnect/AuthKey_<KEY_ID>.p8
# Vendor number for Sales Reports (App Store downloads/units, up to 365 days of history).
# Account-wide, not per-app. Find it in App Store Connect -> Payments and Financial Reports
# (shown at the top as "Vendor number: XXXXXXXX").
ASC_VENDOR_NUMBER=

# Play Console statistics export bucket (installs/uninstalls CSVs).
# Enable in Play Console → Setup → Statistics export, then grant the same service account
# above "Storage Object Viewer" on the bucket in Google Cloud IAM. Bucket name looks like
# pubsite_prod_<id> and is shown on that Play Console settings page.
GOOGLE_PLAY_STATS_BUCKET=
