require "json"
require "fileutils"
require "open3"
require "tmpdir"

default_platform(:ios)

def release_context
  root = File.expand_path("..", __dir__)
  app = JSON.parse(File.read(File.join(root, "apps.json"))).fetch(ENV.fetch("SLUG"))
  # Validation is repeated here so a manual lane invocation cannot bypass the guard.
  sh("python3", File.join(root, "validate.py"))
  source = File.expand_path(File.join(root, "source", app.fetch("workingDirectory")))
  sha, ok = Open3.capture2("git", "-C", source, "rev-parse", "HEAD")
  UI.user_error!("Checkout SHA mismatch") unless ok.success? && sha.strip == ENV.fetch("SHA")
  UI.user_error!("Commit Podfile.lock before building") if uses_cocoapods?(app, source) && !refresh_pods? && !File.file?(pod_lock(app, source))
  [root, app, source]
end

# Swift Package Manager-only projects (Flutter with enable-swift-package-manager) have no Podfile:
# every CocoaPods step is skipped and Xcode resolves the packages itself.
def uses_cocoapods?(app, source)
  File.file?(File.join(source, File.dirname(native_project(app)), "Podfile"))
end

def native_project(app)
  app.fetch("xcodeProject", app.fetch("framework") == "flutter" ? "ios/Runner.xcodeproj" : "ios/App/App.xcodeproj")
end

def native_workspace(app)
  app.fetch("workspace", app.fetch("framework") == "flutter" ? "ios/Runner.xcworkspace" : "ios/App/App.xcworkspace")
end

def refresh_pods?
  ENV["REFRESH_PODS"] == "1"
end

def pod_lock(app, source)
  File.join(source, File.dirname(native_project(app)), "Podfile.lock")
end

def export_pod_lock(root, app, source)
  return unless refresh_pods? && File.file?(pod_lock(app, source))
  FileUtils.mkdir_p(File.join(root, "output"))
  FileUtils.cp(pod_lock(app, source), File.join(root, "output", "Podfile.lock"))
end

# Current Xcode rejects pods that still declare a target below its minimum, and with use_frameworks!
# it rejects SDK private headers that are not modular (AdMob's GoogleMobileAds_Beta.h). This lives in
# the Podfile because flutter build ipa runs pod install again, which regenerates the Pods project.
MINIMUM_POD_DEPLOYMENT_TARGET = "15.0"
POD_DEPLOYMENT_HOOK = <<~RUBY.lines.map { |line| "  #{line}" }.join
  (installer.pods_project.targets.flat_map(&:build_configurations) + installer.pods_project.build_configurations).each do |configuration|
    configuration.build_settings["CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES"] = "YES"
    configuration.build_settings["CLANG_ENABLE_EXPLICIT_MODULES"] = "NO"
    current = configuration.build_settings["IPHONEOS_DEPLOYMENT_TARGET"]
    configuration.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "#{MINIMUM_POD_DEPLOYMENT_TARGET}" if current && Gem::Version.new(current) < Gem::Version.new("#{MINIMUM_POD_DEPLOYMENT_TARGET}")
  end
RUBY

# Pure: runs last in the app's post_install, so its own settings cannot lower the target again.
def with_pod_deployment_hook(podfile)
  lines = podfile.lines
  start = lines.index { |line| line.match?(/^post_install do/) }
  return "#{podfile.chomp}\n\npost_install do |installer|\n#{POD_DEPLOYMENT_HOOK}end\n" unless start
  finish = (start...lines.length).find { |index| lines[index].match?(/^end\s*$/) }
  UI.user_error!("Unexpected post_install block in Podfile") unless finish
  lines.insert(finish, POD_DEPLOYMENT_HOOK).join
end

# Only the disposable checkout changes, never the app repository.
def apply_pod_deployment_hook(app, source)
  podfile = File.join(source, File.dirname(native_project(app)), "Podfile")
  File.write(podfile, with_pod_deployment_hook(File.read(podfile))) if File.file?(podfile)
end

# A gitignored .env declared as a Flutter asset is not in the checkout, and its absence
# would only surface when Xcode bundles the assets, many minutes into the build.
def write_app_env(source)
  pubspec = File.join(source, "pubspec.yaml")
  return unless File.file?(pubspec) && File.read(pubspec).match?(/^\s*-\s*\.env\s*$/)
  env_file = File.join(source, ".env")
  return if File.file?(env_file)
  variable = "APP_ENV_#{ENV.fetch("SLUG").upcase.tr("-", "_")}"
  UI.user_error!("#{variable} is missing: run ios-setup --apply for this app.") if ENV[variable].to_s.empty?
  File.write(env_file, ENV.fetch(variable))
end

# The Runner target imports the plugin modules too, so it needs the settings given to the pods.
def relax_runner_module_checks(source)
  xcconfig = File.join(source, "ios", "Flutter", "Release.xcconfig")
  return unless File.file?(xcconfig)
  File.write(xcconfig, "#{File.read(xcconfig).chomp}\nCLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES\nCLANG_ENABLE_EXPLICIT_MODULES = NO\n")
end

def prepare_flutter(source)
  write_app_env(source)
  relax_runner_module_checks(source)
  Dir.chdir(source) do
    sh("flutter", "pub", "get", "--enforce-lockfile")
    # Generate Flutter's xcconfig before resolving Pods; preserve native project/workarounds.
    sh("flutter", "build", "ios", "--config-only", "--release", "--no-codesign",
       "--build-name", ENV.fetch("BUILD_NAME"), "--build-number", ENV.fetch("BUILD_NUMBER"))
    if File.file?(File.join("ios", "Podfile"))
      Dir.chdir("ios") { refresh_pods? ? sh("pod", "install") : sh("pod", "install", "--deployment") }
    end
  end
end

# FlutterFire reads this global from the Podfile. Only the disposable checkout changes.
def apply_firebase_sdk_version(app, source)
  version = app["firebaseSdkVersion"]
  return unless version
  podfile = File.join(source, File.dirname(native_project(app)), "Podfile")
  File.write(podfile, "$FirebaseSDKVersion = '#{version}'
" + File.read(podfile))
end

def prepare_app(app, source)
  apply_firebase_sdk_version(app, source)
  apply_pod_deployment_hook(app, source)
  if refresh_pods? && uses_cocoapods?(app, source)
    FileUtils.rm_f(pod_lock(app, source))
    # The machine's spec index can predate what the plugins now require.
    sh("pod", "repo", "update")
  end
  return prepare_flutter(source) if app.fetch("framework") == "flutter"
  pnpm = File.file?(File.join(source, "pnpm-lock.yaml"))
  UI.user_error!("Capacitor requires a committed package-lock.json or pnpm-lock.yaml") unless pnpm || File.file?(File.join(source, "package-lock.json"))
  Dir.chdir(source) do
    if pnpm
      # Corepack installs the exact pnpm named by the app's packageManager field.
      ENV["COREPACK_ENABLE_DOWNLOAD_PROMPT"] = "0"
      sh("corepack", "enable")
      sh("pnpm", "install", "--frozen-lockfile")
      sh("pnpm", "run", app.fetch("webBuildScript", "build"))
    else
      sh("npm", "ci")
      sh("npm", "run", app.fetch("webBuildScript", "build"))
    end
    refresh_pods? ? sh("npx", "--no-install", "cap", "sync", "ios") : sh("npx", "--no-install", "cap", "sync", "ios", "--deployment")
  end
  require "xcodeproj"
  project = Xcodeproj::Project.open(File.join(source, native_project(app)))
  app.fetch("targets").each_key do |name|
    target = project.targets.find { |t| t.name == name }
    UI.user_error!("Missing Xcode target #{name}") unless target
    target.build_configurations.each do |configuration|
      configuration.build_settings["CURRENT_PROJECT_VERSION"] = ENV.fetch("BUILD_NUMBER")
      configuration.build_settings["MARKETING_VERSION"] = ENV.fetch("BUILD_NAME")
    end
  end
  project.save
end

# Pure: picks each bundle's App Store profile from decoded .mobileprovision plists.
def profile_mapping(plists, app)
  app.fetch("bundleIds").to_h do |bundle|
    profile = plists.find do |plist|
      plist.fetch("TeamIdentifier", []).include?(app.fetch("teamId")) && !plist.key?("ProvisionedDevices") &&
        plist.fetch("Entitlements", {})["application-identifier"].to_s.sub(/\A[^.]+\./, "") == bundle
    end
    UI.user_error!("Missing App Store profile for #{bundle}") unless profile
    [bundle, profile.fetch("Name")]
  end
end

# Apple is the source of truth: no Mac, .p12 or Match deposit. Certificates and profiles are
# reused when they match CERTIFICATE_PRIVATE_KEY and created when missing; nothing is revoked.
def fetch_codemagic_signing(app)
  require "plist"
  ENV["APP_STORE_CONNECT_KEY_IDENTIFIER"] = ENV.fetch("ASC_KEY_ID")
  ENV["APP_STORE_CONNECT_ISSUER_ID"] = ENV.fetch("ASC_ISSUER_ID")
  ENV["APP_STORE_CONNECT_PRIVATE_KEY"] = ENV.fetch("ASC_KEY_CONTENT")
  sh("keychain", "initialize")
  app.fetch("bundleIds").each do |bundle|
    sh("app-store-connect", "fetch-signing-files", bundle, "--type", "IOS_APP_STORE", "--create")
  end
  sh("keychain", "add-certificates")
  # Codemagic CLI tools save to the Xcode folder; older images used MobileDevice.
  folders = [["Developer", "Xcode", "UserData"], ["MobileDevice"]].map { |parts| File.join(Dir.home, "Library", *parts, "Provisioning Profiles") }
  plists = folders.flat_map { |folder| Dir[File.join(folder, "*.mobileprovision")] }.map do |file|
    decoded, ok = Open3.capture2("security", "cms", "-D", "-i", file)
    UI.user_error!("Unreadable provisioning profile") unless ok.success?
    Plist.parse_xml(decoded)
  end
  identities, ok = Open3.capture2("security", "find-identity", "-v", "-p", "codesigning")
  identity = ok.success? && identities[/"((?:Apple|iPhone|iOS) Distribution)/, 1]
  UI.user_error!("No distribution identity in the keychain") unless identity
  [profile_mapping(plists, app), identity]
end

def receipt(root, state)
  FileUtils.mkdir_p(File.join(root, "output"))
  File.write(File.join(root, "output", "release.json"), JSON.pretty_generate({
    slug: ENV.fetch("SLUG"), sha: ENV.fetch("SHA"), version: ENV.fetch("BUILD_NAME"),
    build: ENV.fetch("BUILD_NUMBER"), correlationId: ENV.fetch("CORRELATION_ID"),
    state: state, runId: ENV["GITHUB_RUN_ID"] || ENV["CM_BUILD_ID"]
  }))
end

def ensure_new_build_number(app)
  builds = Spaceship::ConnectAPI::Build.all(app_id: app.fetch("appId").to_s)
  UI.user_error!("Non-integer ASC build numbering needs manual reconciliation") if builds.any? { |b| b.version !~ /\A[1-9][0-9]*\z/ }
  highest = builds.map { |b| b.version.to_i }.max || 0
  UI.user_error!("Build number already consumed; re-plan from Windows") unless ENV.fetch("BUILD_NUMBER").to_i > highest
end

def upload_ipa(api_key, app, ipa)
  upload_to_testflight(api_key: api_key, app_identifier: app.fetch("bundleIds").first,
    apple_id: app.fetch("appId").to_s, ipa: ipa,
    skip_waiting_for_build_processing: true, skip_submission: true, distribute_external: false)
end

platform :ios do
  # Retries only the upload of an IPA from an earlier build, so nothing is compiled again.
  lane :upload do
    root = File.expand_path("..", __dir__)
    app = JSON.parse(File.read(File.join(root, "apps.json"))).fetch(ENV.fetch("SLUG"))
    sh("python3", File.join(root, "validate.py"))
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"), in_house: false)
    remote = Spaceship::ConnectAPI::App.get(app_id: app.fetch("appId").to_s)
    UI.user_error!("ASC identity mismatch") unless remote.bundle_id == app.fetch("bundleIds").first
    ensure_new_build_number(app)
    ipa = File.join(root, "output", "release.ipa")
    FileUtils.mkdir_p(File.dirname(ipa))
    # Not through sh: the temporary download URL stays out of the log.
    require "open-uri"
    URI.parse(ENV.fetch("IPA_URL")).open { |remote_file| File.open(ipa, "wb") { |file| IO.copy_stream(remote_file, file) } }
    sh("python3", File.join(root, "verify_ipa.py"), ipa)
    upload_ipa(api_key, app, ipa)
    receipt(root, "uploaded_processing_unconfirmed")
  end

  lane :unsigned do
    root, app, source = release_context
    prepare_app(app, source)
    export_pod_lock(root, app, source)
    if app.fetch("framework") == "flutter"
      Dir.chdir(source) do
        sh("flutter", "build", "ios", "--release", "--no-codesign", "--no-pub",
           "--build-name", ENV.fetch("BUILD_NAME"), "--build-number", ENV.fetch("BUILD_NUMBER"))
      end
      apps = Dir[File.join(source, "build", "ios", "iphoneos", "*.app")]
    else
      derived = File.join(source, "build", "ios", "unsigned")
      sh("xcodebuild", "-workspace", File.join(source, native_workspace(app)), "-scheme", app.fetch("scheme"),
         "-configuration", "Release", "-sdk", "iphoneos", "-destination", "generic/platform=iOS", "-derivedDataPath", derived, "CODE_SIGNING_ALLOWED=NO", "build")
      apps = Dir[File.join(derived, "Build", "Products", "Release-iphoneos", "*.app")]
    end
    UI.user_error!("Expected one unsigned app") unless apps.length == 1
    FileUtils.mkdir_p(File.join(root, "output"))
    sh("ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", apps.first, File.join(root, "output", "unsigned-app.zip"))
    receipt(root, "built_unsigned")
  end

  lane :release do
    root, app, source = release_context
    keychain = "ios-release-#{ENV["GITHUB_RUN_ID"] || ENV["CM_BUILD_ID"] || ENV.fetch("CORRELATION_ID")}"
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"), in_house: false)
    remote = Spaceship::ConnectAPI::App.get(app_id: app.fetch("appId").to_s)
    UI.user_error!("ASC identity mismatch") unless remote.bundle_id == app.fetch("bundleIds").first
    check_number = -> { ensure_new_build_number(app) }
    check_number.call
    # Signing takes seconds and compiling takes minutes, so a signing problem must surface first.
    if ENV["CERTIFICATE_PRIVATE_KEY"].to_s.empty?
      setup_ci(keychain_name: keychain, timeout: 3600)
      match(type: "appstore", readonly: true, api_key: api_key, team_id: app.fetch("teamId"),
        app_identifier: app.fetch("bundleIds"), git_url: ENV.fetch("MATCH_GIT_URL"),
        git_branch: ENV.fetch("MATCH_GIT_BRANCH", "signing"), clone_branch_directly: true, keychain_name: keychain)
      profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
      identity = "Apple Distribution"
    else
      profiles, identity = fetch_codemagic_signing(app)
    end
    UI.user_error!("Missing profiles") unless (app.fetch("bundleIds") - profiles.keys).empty?
    prepare_app(app, source)
    export_pod_lock(root, app, source)
    app.fetch("targets").each do |target, bundle|
      update_code_signing_settings(use_automatic_signing: false, path: File.join(source, native_project(app)),
        targets: [target], team_id: app.fetch("teamId"), bundle_identifier: bundle,
        code_sign_identity: identity, profile_name: profiles.fetch(bundle), build_configurations: ["Release"])
    end
    # Projects can keep development push entitlements in source. Change only the
    # disposable CI checkout; never rewrite the developer's project repository.
    require "xcodeproj"
    project = Xcodeproj::Project.open(File.join(source, native_project(app)))
    app.fetch("targets").each do |target_name, bundle|
      target = project.targets.find { |t| t.name == target_name }
      UI.user_error!("Missing Xcode target #{target_name}") unless target
      settings = target.build_configurations.find { |c| c.name == "Release" }.build_settings
      file = settings["CODE_SIGN_ENTITLEMENTS"]
      next unless file && app.fetch("requiredEntitlements", {}).fetch(bundle, {}).key?("aps-environment")
      entitlement_path = File.expand_path(file, File.dirname(File.join(source, native_project(app))))
      UI.user_error!("Entitlements outside checkout") unless entitlement_path.start_with?(source + File::SEPARATOR)
      entitlement_data = Xcodeproj::Plist.read_from_path(entitlement_path)
      entitlement_data["aps-environment"] = "production"
      Xcodeproj::Plist.write_to_path(entitlement_data, entitlement_path)
    end
    export = File.join(ENV.fetch("RUNNER_TEMP", Dir.tmpdir), "ExportOptions.plist")
    require "plist"
    File.write(export, { method: "app-store-connect", signingStyle: "manual", signingCertificate: identity, teamID: app.fetch("teamId"), provisioningProfiles: profiles }.to_plist)
    if app.fetch("framework") == "flutter"
      Dir.chdir(source) do
        sh("flutter", "build", "ipa", "--release", "--no-pub", "--export-options-plist", export,
          "--build-name", ENV.fetch("BUILD_NAME"), "--build-number", ENV.fetch("BUILD_NUMBER"))
      end
    else
      # Not build_app: its validation rejects the app-store-connect method that current Xcode expects.
      archive = File.join(source, "build", "ios", "App.xcarchive")
      sh("xcodebuild", "-workspace", File.join(source, native_workspace(app)), "-scheme", app.fetch("scheme"),
        "-configuration", "Release", "-destination", "generic/platform=iOS", "-archivePath", archive, "clean", "archive")
      sh("xcodebuild", "-exportArchive", "-archivePath", archive, "-exportOptionsPlist", export,
        "-exportPath", File.join(source, "build", "ios", "ipa"))
    end
    ipas = Dir[File.join(source, "build", "ios", "ipa", "*.ipa")]
    UI.user_error!("Expected exactly one IPA") unless ipas.length == 1
    sh("python3", File.join(root, "verify_ipa.py"), ipas.first)
    FileUtils.mkdir_p(File.join(root, "output"))
    FileUtils.cp(ipas.first, File.join(root, "output", "release.ipa"))
    receipt(root, "built")
    if ENV.fetch("MODE") == "testflight"
      check_number.call
      upload_ipa(api_key, app, ipas.first)
      receipt(root, "uploaded_processing_unconfirmed")
    end
  end
end
